{
  "name": "@partnersinbiz/pib-plugin-kit",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "Worker-side helpers shared by the Partners in Biz Paperclip plugins.",
  "exports": {
    ".": "./src/index.ts",
    "./oauth-client": "./src/oauth-bridge/client.ts",
