    {
      "content": "[0:v]setpts=PTS-STARTPTS,fps=30,scale=w=1080:h=1920:force_original_aspect_ratio=decrease:force_divisible_by=2,pad=w=1080:h=1920:x=(ow-iw)/2:y=(oh-ih)/2:color=black,format=yuv420p,setsar=1,trim=duration=3[seg0];
[1:v]setpts=PTS-STARTPTS,fps=30,format=yuva420p,scale=w=1080:h=1920:force_original_aspect_ratio=decrease:force_divisible_by=2[ov1];
[seg0][ov1]overlay=x=(W-w)/2+0:y=(H-h)/2+0:eof_action=pass[base2];
[base2]format=yuv420p,setsar=1[vout]
",
      "name": "video.graph",
    },
  ],
}
`;

