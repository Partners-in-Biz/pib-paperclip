// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`compile audio snapshots > mixed music + voiceover + clip audio: amix normalize=0, volume, fades, delay 1`] = `
{
  "args": [
    "-hide_banner",
    "-nostdin",
    "-y",
    "-threads",
    "2",
    "-ss",
    "0",
    "-t",
    "4",
    "-i",
    "file:in/a.mp4",
    "-threads",
    "2",
    "-ss",
    "0",
    "-t",
    "2",
    "-i",
    "file:in/mute.mp4",
    "-ss",
    "0",
    "-t",
    "4",
    "-i",
    "file:in/a.mp4",
    "-ss",
    "10",
    "-t",
    "6",
    "-i",
    "file:in/music.m4a",
    "-ss",
    "0",
    "-t",
    "3",
    "-i",
    "file:in/vo.wav",
    "-filter_complex_threads",
    "4",
    "-filter_complex_script",
    "video.graph",
    "-map",
    "[vout]",
    "-map",
    "[aout]",
    "-c:a",
    "aac",
    "-b:a",
    "160k",
    "-ar",
    "48000",
    "-ac",
    "2",
    "-c:v",
    "libx264",
    "-profile:v",
    "high",
    "-preset",
    "medium",
    "-crf",
    "20",
    "-maxrate",
    "6M",
    "-bufsize",
    "12M",
    "-pix_fmt",
    "yuv420p",
    "-threads",
    "4",
    "-r",
    "30",
    "-t",
    "6",
    "-movflags",
    "+faststart",
    "file:out.mp4",
  ],
  "files": [
    {
      "content": "[0:v]setpts=PTS-STARTPTS,fps=30,scale=w=1080:h=1920:force_original_aspect_ratio=decrease:force_divisible_by=2,pad=w=1080:h=1920:x=(ow-iw)/2:y=(oh-ih)/2:color=black,format=yuv420p,setsar=1,fade=t=in:st=0:d=0.5,trim=duration=4[seg0];
[1:v]setpts=PTS-STARTPTS,fps=30,scale=w=1080:h=1920:force_original_aspect_ratio=decrease:force_divisible_by=2,pad=w=1080:h=1920:x=(ow-iw)/2:y=(oh-ih)/2:color=black,format=yuv420p,setsar=1,trim=duration=2[seg1];
[seg0][seg1]concat=n=2:v=1:a=0,settb=1/30[cat2];
[cat2]format=yuv420p,setsar=1[vout];
[2:a]aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo,atrim=duration=4,asetpts=PTS-STARTPTS,atrim=duration=4,afade=t=in:st=0:d=0.5[aud0];
[3:a]aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo,atrim=duration=6,asetpts=PTS-STARTPTS,atrim=duration=6,volume=0.3,afade=t=out:st=5:d=1[aud1];
[4:a]aresample=48000,aformat=sample_fmts=fltp:channel_layouts=stereo,atrim=duration=3,asetpts=PTS-STARTPTS,atrim=duration=3,volume=1.5,adelay=delays=1500:all=1[aud2];
[aud0][aud1][aud2]amix=inputs=3:duration=longest:normalize=0,apad=whole_dur=6,atrim=duration=6[aout]
",
      "name": "video.graph",
    },
  ],
}
`;

exports[`compile audio snapshots > silent edit: no audio input, no audio map, -an 1`] = `
