exports[`keyframed x/y/scale/rotate: compiled graph > x/y keys on an identity main clip: static shape, per-frame overlay position at offset 0 1`] = `
"[0:v]setpts=PTS-STARTPTS,fps=30,format=yuva420p,scale=w=1080:h=1920:force_original_aspect_ratio=decrease:force_divisible_by=2[shp1];
color=c=black:s=1080x1920:r=30:d=3,format=yuv420p,setsar=1[blk2];
[blk2][shp1]overlay=x='(W-w)/2+if(lt(t,0),(-100),if(lt(t,3),(-100)+200*((t-0)/3),100))':y='(H-h)/2+if(lt(t,1),50,if(lt(t,2),50,0))':eval=frame:eof_action=pass,format=yuv420p,setsar=1,trim=duration=3[seg0];
[seg0]format=yuv420p,setsar=1[vout]
"
`;
