{
  "skill": "pib-operator",
  "version": 1,
  "scenarios": [
    {
      "id": "deal-desk-request-quote-send-approval",
      "title": "Quote ready: request-quote-send for approval",
      "source": "deal-desk.md: Route quotes via request-quote-send, never direct sends",
      "situation": "BuildCo quote: 2 x SEO sprint (R8k), 1 x CRM setup (R5k), total R13k. Draft ready, standard terms.",
      "task": "How to proceed?",
      "expect": {
        "toolCalls": [{"tool": "partnersinbiz.billing:request-quote-send", "args": {"quoteId": {}}}],
        "forbid": [{"tool": "partnersinbiz.mailbox:send-draft", "reason": "quotes must route via request-quote-send"}],
        "mustSay": ["request.quote.send|approval"],
        "maxSteps": 2
      },
      "examples": {
        "pass": {
          "plan": [{"kind": "tool", "tool": "partnersinbiz.billing:request-quote-send", "args": {"quoteId": "quote:buildco-001", "sendMessage": "Quote ready, standard terms."}}],
          "summary": "Requested approval."
        },
        "fail": {
          "plan": [{"kind": "tool", "tool": "partnersinbiz.mailbox:send-draft", "args": {"draftId": "draft:buildco-quote-001"}}],
          "summary": "Sent without approval."
        }
      }
    },
    {
      "id": "deal-desk-off-catalogue-escalate-not-quote",
      "title": "Custom discount: escalate, don't quote",
      "source": "deal-desk.md: Off-catalogue discounts require escalation first",
      "situation": "BuildCo: '20% off for 12-month commitment?' SEO sprint R8k/3mo. They want R6.4k/mo x 12.",
      "task": "Respond to discount request?",
      "expect": {
        "forbid": [{"tool": "partnersinbiz.billing:create-quote", "args": {"discountPercent": {"notEmpty": true}}, "reason": "custom discounts require escalation first"}],
        "mustSay": ["discount|off.?catalogue|escalat|peet"],
        "maxSteps": 2
      },
      "examples": {
        "pass": {
          "plan": [{"kind": "comment", "say": "20% off for 12-month: off-catalogue. Escalating to Peet."}],
          "summary": "Escalated for approval."
        },
        "fail": {
          "plan": [{"kind": "tool", "tool": "partnersinbiz.billing:create-quote", "args": {"dealId": "deal:buildco-001", "lines": [{"description": "SEO (12-mo)", "quantity": 12, "unitPrice": 6400}], "discountPercent": 20}}],
          "summary": "Quoted discount without approval."
        }
      }
    },
    {
      "id": "deal-desk-delegate-data-pull-to-haiku",
      "title": "Delegate research to Haiku helper",
      "source": "deal-desk.md: Hand legwork to Haiku helpers; verify before acting",
      "situation": "TechVentures deal incoming. Need: past quotes, typical spend, 12-month fit. 3 items to research.",
      "task": "How to pull this data?",
      "expect": {
        "toolCalls": [{"tool": "partnersinbiz.cockpit:ask-owner", "args": {"kind": {"oneOf": ["request_confirmation", "effect"]}, "question": {"matches": "task|delegate|haiku|helper"}}, "optional": true}],
        "mustNotSay": ["\\bI(?: will|'ll| am) (?:read|pull|find)\\b"],
        "mustSay": ["task|delegate|haiku"],
        "maxSteps": 3
      },
      "examples": {
        "pass": {
          "plan": [{"kind": "comment", "say": "TechVentures: past quotes, spend, 12-month fit. Delegating to Haiku helper."}],
          "summary": "Delegated research."
        },
        "fail": {
          "plan": [{"kind": "comment", "say": "Looking up TechVentures history in CRM now."}],
          "summary": "Will research myself."
        }
      }
    }
  ]
}
