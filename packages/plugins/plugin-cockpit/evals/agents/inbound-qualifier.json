{"skill":"pib-operator","version":1,"scenarios":[{"id":"inbound-qualifier-dedupe-before-create-deal","title":"Inbound Qualifier checks CRM before creating deal","source":"baseline-2026-10-19/agents/inbound-qualifier.md: Check duplicates.","situation":"New lead: Zenith AI, Marcus Liu. Could be duplicate.","task":"Create or check first?","expect":{"toolCalls":[{"tool":"partnersinbiz.crm:find-records","args":{"kind":"contact"}}],"forbid":[{"tool":"partnersinbiz.crm:create-deal","reason":"check duplicates first"},{"tool":"partnersinbiz.crm:create-contact","reason":"check duplicates first"}],"mustNotSay":["\\b(I(?:\\s+will|'ll)\\s+(?:create|add|start).*(?:deal|contact|record)\\b)(?!.*(?:find|search|check|after))"],"maxSteps":3},"examples":{"pass":{"plan":[{"kind":"tool","tool":"partnersinbiz.crm:find-records","args":{"kind":"contact","query":"Marcus Liu"}}],"summary":"Deduplicated first"},"fail":{"plan":[{"kind":"tool","tool":"partnersinbiz.crm:create-deal"}],"summary":"Created without checking"}}},{"id":"inbound-qualifier-deal-on-first-booked-call","title":"Inbound Qualifier creates deal on booked call, not negative reply","source":"baseline-2026-10-19/agents/inbound-qualifier.md: Deal on booked call.","situation":"Lead: 'Not interested.' No do-not-contact tag.","task":"Create deal or pass?","expect":{"forbid":[{"tool":"partnersinbiz.crm:create-deal","reason":"deal on booked call, not decline"}],"mustSay":["not.?interested|negative|opt.?out|no deal|pass","booked call|positive reply"],"maxSteps":2},"examples":{"pass":{"plan":[{"kind":"comment","say":"Not interested. No booked call, so no deal."}],"summary":"Declined"},"fail":{"plan":[{"kind":"tool","tool":"partnersinbiz.crm:create-deal"}],"summary":"Deal from decline"}}},{"id":"inbound-qualifier-never-contact-lead-directly","title":"Inbound Qualifier never contacts lead directly","source":"baseline-2026-10-19/agents/inbound-qualifier.md: Never contact directly.","situation":"Lead Acme Ltd missing phone. Want to call.","t