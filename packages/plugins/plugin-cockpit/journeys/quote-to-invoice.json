{
  "key": "quote-to-invoice",
  "version": 4,
  "title": "Deal, quote, accepted, invoice ready to send",
  "summary": "From a qualified canary client to a draft invoice behind its send approval: a deal, a quote with a line, the customer accepting (the CRM marks the deal won), Billing turning the accepted quote into a draft invoice by itself and routing the send to the Reviewer first. The journey only reads what Billing did; it does not convert or ask for the send. It stops at the approval: only a person approves a send, and the run cancels the canary's own approval afterwards. The payment proof leg waits for Billing to record a canary payment without a person (see the README).",
  "schedule": [
    "release",
    "on-demand"
  ],
  "plugins": [
    "partnersinbiz.crm",
    "partnersinbiz.billing"
  ],
  "ownerRole": "account-manager",
  "steps": [
    {
      "id": "ensure-canary",
      "title": "Find the canary client",
      "kind": "tool",
      "tool": "partnersinbiz.crm:create-canary-client",
      "input": {
        "runRef": "{{runId}}"
      },
      "expect": [
        {
          "path": "runRef",
          "equals": "{{runId}}"
        },
        {
          "path": "client",
          "equals": "{{client}}"
        },
        {
          "path": "contact.email",
          "endsWith": "@canary.invalid"
        }
      ],
      "capture": {
        "contactId": {
          "path": "contact.ref",
          "strip": "contact:"
        }
      },
      "ownerRole": "account-manager",
      "note": "Make this call NOW with exactly the input above (it carries this run's id, which the answer must echo): an answer from an earlier call, or from the previous journey, is stale because that journey's last step removed the canary."
    },
    {
      "id": "create-deal",
      "title": "Open a deal",
      "kind": "tool",
      "tool": "partnersinbiz.crm:create-deal",
      "input": {
        "title": "Canary rehearsal {{runId}}",
        "amountMinor": 100000,
        "currency": "ZAR",
        "companyRecordId": "{{companyRecordId}}",
        "contactId": "{{contactId}}"
      },
      "expect": [
        {
          "path": "id",
          "notEmpty": true
        },
        {
          "path": "client",
          "equals": "{{client}}"
        }
      ],
      "capture": {
        "dealId": {
          "path": "id"
        }
      },
      "ownerRole": "account-manager"
    },
    {
      "id": "draft-quote",
      "title": "Draft the quote",
      "kind": "tool",
      "tool": "partnersinbiz.billing:create-quote",
      "input": {
        "currency": "ZAR",
        "customerKind": "company",
        "customerRef": "{{companyRecordId}}",
        "customerName": "PiB Canary Co",
        "customerEmail": "canary@canary.invalid",
        "dealId": "{{dealId}}",
        "notes": "Acceptance canary {{runId}}: never send."
      },
      "expect": [
        {
          "path": "status",
          "equals": "draft"
        },
        {
          "path": "customerRef",
          "equals": "{{companyRecordId}}"
        },
        {
          "path": "dealId",
          "equals": "{{dealId}}"
        }
      ],
      "capture": {
        "quoteId": {
          "path": "id"
        }
      },
      "ownerRole": "account-manager"
    },
    {
      "id": "add-quote-line",
      "title": "Add a line to the quote",
      "kind": "tool",
      "tool": "partnersinbiz.billing:add-quote-line",
      "input": {
        "quoteId": "{{quoteId}}",
        "description": "Canary service",
        "quantity": 1,
        "unitAmountMinor": 100000
      },
      "expect": [
        {
          "path": "$",
          "notEmpty": true
        }
      ],
      "ownerRole": "account-manager"
    },
    {
      "id": "accept-quote",
      "title": "The customer accepts the quote",
      "kind": "tool",
      "tool": "partnersinbiz.billing:set-quote-status",
      "input": {
        "quoteId": "{{quoteId}}",
        "status": "accepted"
      },
      "expect": [
        {
          "path": "status",
          "equals": "accepted"
        },
        {
          "path": "acceptedAt",
          "notEmpty": true
        }
      ],
      "ownerRole": "account-manager"
    },
    {
      "id": "deal-won",
      "title": "The CRM marked the deal won",
      "kind": "tool",
      "tool": "partnersinbiz.crm:list-deals",
      "input": {
        "client": "{{client}}",
        "status": "won"
      },
      "note": "Billing tells the CRM within seconds. If total is 0, wait 30 seconds and ask again once before recording.",
      "expect": [
        {
          "path": "total",
          "gte": 1
        }
      ],
      "ownerRole": "account-manager"
    },
    {
      "id": "quote-converted",
      "title": "Billing converted the accepted quote by itself",
      "kind": "tool",
      "tool": "partnersinbiz.billing:quote-detail",
      "input": {
        "quoteId": "{{quoteId}}"
      },
      "note": "Billing converts the quote when the deal is won, within seconds. If the quote is still accepted, wait 30 seconds and read it again once before recording. If it is still accepted then, record that: do not convert it yourself.",
      "expect": [
        {
          "path": "quote.status",
          "equals": "converted"
        },
        {
          "path": "quote.convertedInvoiceId",
          "notEmpty": true
        },
        {
          "path": "quote.totalMinor",
          "gte": 1
        }
      ],
      "capture": {
        "invoiceId": {
          "path": "quote.convertedInvoiceId"
        },
        "quoteTotalMinor": {
          "path": "quote.totalMinor"
        }
      },
      "ownerRole": "account-manager"
    },
    {
      "id": "invoice-drafted",
      "title": "The invoice is a draft with the quote's total and the deal",
      "kind": "tool",
      "tool": "partnersinbiz.billing:invoice-detail",
      "input": {
        "invoiceId": "{{invoiceId}}"
      },
      "expect": [
        {
          "path": "invoice.status",
          "equals": "draft"
        },
        {
          "path": "invoice.totalMinor",
          "equals": "{{quoteTotalMinor}}"
        },
        {
          "path": "invoice.dealId",
          "equals": "{{dealId}}"
        }
      ],
      "ownerRole": "account-manager"
    },
    {
      "id": "invoice-send-approval",
      "title": "The send approval Billing opened reaches the Reviewer first",
      "kind": "tool",
      "tool": "partnersinbiz.billing:invoice-detail",
      "input": {
        "invoiceId": "{{invoiceId}}"
      },
      "note": "Billing routes the send approval when it drafts the invoice, so nothing is requested here. Do NOT approve it, do not touch it: the Cockpit checks where it went and cancels the canary's approval when the run ends. If approvalIssueId is empty, record that as it is; do not call request-invoice-send to fill it.",
      "expect": [
        {
          "path": "invoice.pendingAction",
          "equals": "send"
        },
        {
          "path": "invoice.approvalIssueId",
          "notEmpty": true
        }
      ],
      "probe": {
        "kind": "approval-route",
        "idPath": "invoice.approvalIssueId",
        "outward": true
      },
      "ownerRole": "account-manager"
    },
    {
      "id": "cleanup",
      "title": "Remove the canary's records",
      "kind": "tool",
      "tool": "partnersinbiz.crm:cleanup-canary",
      "input": {
        "confirm": true
      },
      "expect": [
        {
          "path": "cleaned",
          "equals": true
        },
        {
          "path": "company",
          "equals": "{{client}}"
        }
      ],
      "always": true,
      "ownerRole": "account-manager"
    }
  ]
}
